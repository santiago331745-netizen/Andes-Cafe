<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_header" android:paddingTop="56dp" android:paddingBottom="40dp">
      <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_coffee" android:contentDescription="@string/logo_andescaf" app:tint="@color/cafe_accent"/>
    <TextView  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/bienvenido_a_andescaf" android:textAppearance="@style/TextAppearance.AndesCafe.OnHeader" android:layout_marginTop="8dp"/>
    <TextView  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/inicia_sesin_para_continuar" android:textAppearance="@style/TextAppearance.AndesCafe.OnHeaderSub" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilEmail" style="@style/Widget.AndesCafe.TextInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:hint="@string/correo_electrnico" >
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilPassword" style="@style/Widget.AndesCafe.TextInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:hint="@string/contrasea" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbRemember" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/cafe_primary" android:checked="true" android:text="@string/habilitar_huella_en_este_dispositivo"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnLogin" style="@style/Widget.AndesCafe.Button"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/iniciar_sesin" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnBiometric" style="@style/Widget.AndesCafe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ingresar_con_huella" app:icon="@drawable/ic_lock"/>
    <TextView android:id="@+id/tvForgot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/olvidaste_tu_contrasea" android:textAppearance="@style/TextAppearance.AndesCafe.Title" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:padding="8dp" android:textColor="@color/cafe_accent"/>
    <TextView android:id="@+id/tvRegister" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_tienes_cuenta_regstrate" android:textAppearance="@style/TextAppearance.AndesCafe.Title" android:layout_gravity="center_horizontal" android:padding="8dp" android:textColor="@color/cafe_primary"/>

    </LinearLayout>
  </LinearLayout>
</ScrollView>
