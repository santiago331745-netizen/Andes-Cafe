<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
    <ImageView android:id="@+id/ivPreview" android:layout_width="match_parent" android:layout_height="200dp" android:background="@drawable/bg_product_image" android:clipToOutline="true" android:padding="56dp" android:src="@drawable/ic_coffee" android:contentDescription="@null" app:tint="@color/cafe_primary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="16dp">
      <com.google.android.material.button.MaterialButton android:id="@+id/btnCamera" style="@style/Widget.AndesCafe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/tomar_foto"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnGallery" style="@style/Widget.AndesCafe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/galera"/>
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout  style="@style/Widget.AndesCafe.TextInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:hint="@string/nombre_del_producto" >
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etName"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout  style="@style/Widget.AndesCafe.TextInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:hint="@string/descripcin" >
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDesc"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout  style="@style/Widget.AndesCafe.TextInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:hint="@string/precio_cop" >
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPrice"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout  style="@style/Widget.AndesCafe.TextInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:hint="@string/existencias" >
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStock"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" style="@style/Widget.AndesCafe.Button"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/guardar_producto" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel" style="@style/Widget.AndesCafe.Button.Outlined"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/cancelar" />

    </LinearLayout>
  </LinearLayout>
</ScrollView>
