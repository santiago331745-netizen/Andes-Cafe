<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.AndesCafe.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/cafe_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TextAppearance.AndesCafe.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/cafe_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.AndesCafe.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/cafe_on_surface_variant</item>
    </style>
    <style name="TextAppearance.AndesCafe.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/cafe_primary_light</item>
    </style>
    <style name="TextAppearance.AndesCafe.OnHeader" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.AndesCafe.OnHeaderSub" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/cafe_container</item>
    </style>
    <style name="Widget.AndesCafe.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cafe_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">@dimen/corner_button</item>
    </style>
    <style name="Widget.AndesCafe.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/cafe_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/cafe_primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">@dimen/corner_button</item>
    </style>
    <style name="Widget.AndesCafe.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/cafe_primary</item>
        <item name="hintTextColor">@color/cafe_primary</item>
        <item name="boxBackgroundColor">@color/cafe_surface</item>
    </style>
    <style name="Widget.AndesCafe.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/cafe_surface</item>
        <item name="strokeColor">@color/cafe_container</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
